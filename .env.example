# Copy to .env (git-ignored). Never commit real values.
# Kaggle API (optional, only for `xact-tb fetch-kaggle`). Prefer ~/.kaggle/kaggle.json (chmod 600).
KAGGLE_USERNAME=
KAGGLE_KEY=
# Where data / caches / runs live (all git-ignored)
XACT_DATA_DIR=./data
XACT_CACHE_DIR=./cache
XACT_RUNS_DIR=./runs
